package practice.com;

import java.util.function.Consumer;
public class Employee {
	public static void main(String[] args) {
		Consumer<Integer> cn=salary->{
		if(salary>3000) {
			System.out.println(salary+4000);
		}
		else {
			System.out.println(salary+1000);
		}
		
	};
	cn.accept(40000);
	cn.accept(20000);
	}
}
