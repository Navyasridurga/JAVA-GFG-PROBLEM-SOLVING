package practice.com;
import java.util.function.Function;


public class Double {
	public static void main(String[] args) {
		Function<Integer,Integer> fn=n->n*2;
		Function<Integer,Integer> fn1=n->n*n;
		
		Function<Integer,Integer> fn2=salary->(salary+5000);
		System.out.println(fn2.apply(25000));
		
		System.out.println(fn.apply(5));
		System.out.println(fn1.apply(6));
	}

}
